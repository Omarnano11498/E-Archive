<Window x:Class="EArchive.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="الأرشيف الإلكتروني" Height="760" Width="1250" WindowStartupLocation="CenterScreen"
 FlowDirection="RightToLeft">
 <Grid Margin="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="نظام الأرشيف الإلكتروني" FontSize="24" FontWeight="Bold" Margin="4,4,4,12"/>
  <GroupBox Grid.Row="1" Header="بيانات المستند" Padding="8">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Grid.Row="0" Grid.Column="0"><Label Content="عنوان المستند"/><TextBox x:Name="TitleBox"/></StackPanel>
    <StackPanel Grid.Row="0" Grid.Column="1"><Label Content="المصدر"/><TextBox x:Name="SourceBox"/></StackPanel>
    <StackPanel Grid.Row="0" Grid.Column="2"><Label Content="الجهة / المرسل إليه"/><TextBox x:Name="DestinationBox"/></StackPanel>
    <StackPanel Grid.Row="0" Grid.Column="3"><Label Content="المرفق"/><DockPanel><TextBox x:Name="FileBox" IsReadOnly="True"/><Button Content="اختيار" Click="ChooseFile_Click"/></DockPanel></StackPanel>
    <StackPanel Grid.Row="1" Grid.Column="0"><Label Content="من تاريخ"/><DatePicker x:Name="DateFromPicker" Margin="4"/></StackPanel>
    <StackPanel Grid.Row="1" Grid.Column="1"><Label Content="إلى تاريخ"/><DatePicker x:Name="DateToPicker" Margin="4"/></StackPanel>
    <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"><Label Content="ملاحظات تفصيلية"/><TextBox x:Name="NotesBox" Height="54" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></StackPanel>
    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Left">
     <Button Content="حفظ في الأرشيف" Click="Save_Click" MinWidth="130"/>
     <Button Content="تعديل السجل المحدد" Click="Edit_Click" MinWidth="130"/>
     <Button Content="حذف السجل المحدد" Click="Delete_Click" MinWidth="130"/>
     <Button Content="فتح المرفق المحدد" Click="OpenSelected_Click"/>
     <Button Content="تصدير Excel" Click="Export_Click"/>
     <Button Content="تحديث" Click="Refresh_Click"/>
    </StackPanel>
   </Grid>
  </GroupBox>
  <GroupBox Grid.Row="2" Header="البحث والسجلات" Padding="6" Margin="0,10,0,0">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
     <TextBox x:Name="SearchBox" Width="300" ToolTip="ابحث في العنوان والمصدر والجهة والملاحظات" TextChanged="SearchBox_TextChanged"/>
     <DatePicker x:Name="FilterFromPicker" Width="150" Margin="4" SelectedDateChanged="FilterChanged"/>
     <DatePicker x:Name="FilterToPicker" Width="150" Margin="4" SelectedDateChanged="FilterChanged"/>
     <Button Content="مسح الفلاتر" Click="ClearFilters_Click"/>
    </StackPanel>
    <DataGrid x:Name="RecordsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
              SelectionMode="Single" SelectionChanged="RecordsGrid_SelectionChanged" Margin="4" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
              VirtualizingPanel.VirtualizationMode="Recycling">
     <DataGrid.Columns>
      <DataGridTextColumn Header="رقم" Binding="{Binding Id}" Width="65"/>
      <DataGridTextColumn Header="العنوان" Binding="{Binding Title}" Width="170"/>
      <DataGridTextColumn Header="المصدر" Binding="{Binding Source}" Width="120"/>
      <DataGridTextColumn Header="الجهة" Binding="{Binding Destination}" Width="120"/>
      <DataGridTextColumn Header="من تاريخ" Binding="{Binding DateFrom, StringFormat=d}" Width="100"/>
      <DataGridTextColumn Header="إلى تاريخ" Binding="{Binding DateTo, StringFormat=d}" Width="100"/>
      <DataGridTextColumn Header="اسم الملف" Binding="{Binding OriginalFileName}" Width="180"/>
      <DataGridTextColumn Header="الملاحظات" Binding="{Binding Notes}" Width="*"/>
     </DataGrid.Columns>
    </DataGrid>
   </DockPanel>
  </GroupBox>
  <TextBlock x:Name="StatusText" Grid.Row="3" Margin="4,8" Text="جاهز"/>
 </Grid>
</Window>